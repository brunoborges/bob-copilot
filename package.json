  },
  "dependencies": {
    "@github/copilot": "1.0.79",
    "@github/copilot-sdk": "^1.0.11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  }
